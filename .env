# ---------------------------------------
# | Override env block in openclaw.json |
# ---------------------------------------

# -----------------------------------------------------------------------------
# Gateway auth + paths
# -----------------------------------------------------------------------------
OPENCLAW_GATEWAY_PASSWORD=minhng.info
OPENCLAW_GATEWAY_ALLOWED_ORIGIN_DOMAIN=""       # https://openclaw.example.com

# -----------------------------------------------------------------------------
# Model provider API keys (set at least one)
# -----------------------------------------------------------------------------
# Configure your primary model provider
MODEL_PROVIDER="openai"
MODEL_PROVIDER_BASE_URL="https://api.openai.com"
MODEL_PROVIDER_API_KEY="sk-XXX"
MODEL_PROVIDER_API_ADAPTER="openai-completions"     # openai-completions | openai-responses | anthropic-messages | google-generative-ai
MODEL_PROVIDER_MODEL_ID="gpt-5.4"

# -----------------------------------------------------------------------------
# Channels
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="XXX:XXX"     # See: https://docs.openclaw.ai/channels/telegram
